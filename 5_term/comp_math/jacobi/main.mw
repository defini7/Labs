<Group labelreference="L4" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="2D Input" size="16" family="Monospaced" layout="Normal"><Font size="16" family="Monospaced">restart:
with(LinearAlgebra):
with(RandomTools):</Font></Text-field>
</Input>
</Group>
<Group labelreference="L10" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="2D Input" size="16" family="Monospaced" layout="Normal"><Font size="16" encoding="UTF-8" family="Monospaced"># 1000x1000 -&gt; 8000000 \320\261\320\260\320\271\321\202 ~ 7.6 \320\274\320\261\320\260\320\271\321\202
</Font><Font size="16" family="Monospaced">
N := 1000:
MAX_ITERS := 10000:
EPSILON := 1e-10:

randomize(20):

x_target := RandomVector(N, generator=0.0 .. 1.0, datatype=float[8]):

A := RandomMatrix(N, generator=0.0 .. 1.0, datatype=float[8]):
row_sums := A . Vector(N, fill=1.0, datatype=float[8]):

A := A + DiagonalMatrix(2.0 *~ row_sums):

b := A . x_target:</Font></Text-field>
</Input>
</Group>
<Group labelreference="L11" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="2D Input" size="16" family="Monospaced" layout="Normal"><Font size="16" family="Monospaced">local D := Diagonal(A):
B := A - DiagonalMatrix(D):
D_inv := 1 /~ D:
C := -DiagonalMatrix(D_inv) . B:
r := D_inv *~ b:

x_prev := Vector(N, fill=1.0, datatype=float[8]):</Font></Text-field>
</Input>
</Group>
<Group labelreference="L12" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="2D Input" size="16" family="Monospaced" layout="Normal"><Font size="16" family="Monospaced">t0 := time():

for i from 1 to MAX_ITERS do
  x_new := C . x_prev + r:

  if Norm(x_new - x_prev, 2) &lt; EPSILON then
    break:
  end if:

  x_prev := x_new:
end do:

t1 := time():</Font></Text-field>
</Input>
</Group>
<Group labelreference="L14" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="2D Input" size="16" family="Monospaced" layout="Normal"><Font size="16" encoding="UTF-8" family="Monospaced">printf(&quot;\320\222\321\200\320\265\320\274\321\217: %f \321\201\320\265\320\272\321\203\320\275\320\264\134n&quot;, t1 - t0):
printf(&quot;\320\230\321\202\320\265\321\200\320\260\321\206\320\270\320\271 \320\262\321\213\320\277\320\276\320\273\320\275\320\265\320\275\320\276: %d\134n&quot;, i):
printf(&quot;\320\236\321\202\320\275\320\276\321\201\320\270\321\202\320\265\320\273\321\214\320\275\320\260\321\217 \320\276\321\210\320\270\320\261\320\272\320\260: %f\134n&quot;, Norm(x_new - x_target, 2) / Norm(x_target, 2)):
printf(&quot;\320\220\320\261\321\201\320\276\320\273\321\216\321\202\320\275\320\260\321\217 \320\276\321\210\320\270\320\261\320\272\320\260: %f\134n&quot;, Norm(x_new - x_target, 2)):</Font></Text-field>
</Input>
